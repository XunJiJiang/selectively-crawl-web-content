# 复制为部署目录的 .env；文件中的键优先于进程环境。
PORT=3200
# 查询 PORT 到 PORT + PORT_SEARCH_RANGE（含两端）；0 表示只尝试 PORT。
PORT_SEARCH_RANGE=20
HOST=http://localhost
# null 关闭 token 验证；留空会生成随机 token。
TOKEN=
# false/0 完全禁用 Redis，仅使用内存和文件缓存；默认 true。
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_TIMEOUT=5000
# Redis key 形如 scwc::plugin:<目录名>:<key>；清理只影响这个前缀。
REDIS_KEY_PREFIX=scwc
# 取消注释启用自定义目录。相对路径以 .env 所在目录为基准。
# SCWC_PLUGIN_DIR=./plugins
# 启用终端时的可选配置。源码目录默认 projects/terminal/plugins；可执行文件默认 terminal/plugins。
# SCWC_CMD_PLUGIN_DIR=./terminal/plugins
# SCWC_TERMINAL_STATE_FILE=./data/terminal/state.json
# SCWC_TERMINAL_PERSIST=false
