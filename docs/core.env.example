# 打包时作为部署目录的 .env；内置默认值，文件中的键优先于进程环境。
PORT=3200
# 查询 PORT 到 PORT + PORT_SEARCH_RANGE（含两端）；0 表示只尝试 PORT。
PORT_SEARCH_RANGE=20
HOST=http://localhost
# null 关闭 token 验证；留空会生成随机 token。
TOKEN=
# false/0 完全禁用 Redis，仅使用内存和文件缓存；默认 true。
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_TIMEOUT=5000
# Redis key 形如 cache-redis::plugin:<目录名>:<key>；清理只影响这个前缀。
REDIS_KEY_PREFIX=cache-redis
# 核心插件目录。相对路径以 .env 所在目录为基准。
# 已配置此项时，用 --plugin-dir 覆盖需要确认。
SCWC_PLUGIN_DIR=./plugins
# 外置 Node 运行时版：可指定 Node.js >=25 的文件路径；相对路径以部署目录为基准。
# 没有固定路径默认值，留空时 start.ps1 / start.sh 从 PATH 查找；内置 Node 版不使用此选项。
# 例如：SCWC_NODE_PATH="C:/Program Files/nodejs/node.exe"
SCWC_NODE_PATH=
# 启用终端时的配置。两种发行包默认 terminal/plugins。
SCWC_CMD_PLUGIN_DIR=./terminal/plugins
SCWC_TERMINAL_STATE_FILE=./data/terminal/state.json
# false 禁用终端状态持久化；默认 true。
SCWC_TERMINAL_PERSIST=true
# 核心运行时 data 目录，相对路径以部署目录为基准。
# 插件配置与 macOS 通知辅助应用保存在此目录的 scwc 子目录。
SCWC_DATA_DIR=./data
# 可选：覆盖工作台库位置；留空使用 data 目录的 web/workbench.sqlite。
SCWC_WEB_WORKBENCH_DB=
